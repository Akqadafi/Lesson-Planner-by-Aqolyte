# Copy this file to .env and replace the placeholder values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
FLASK_SECRET_KEY=replace-with-a-long-random-value
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# Optional absolute path; defaults to LibreOffice installation/PATH lookup.
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.com

# auto prefers LibreOffice, then installed Word on Windows desktops
PDF_BACKEND=auto

# Generation attempts: fixed UTC hour per session and UTC day for whole app.
# Failures count; limits do not represent a dollar budget. Values must be positive.
GENERATION_SESSION_HOURLY=10
GENERATION_GLOBAL_DAILY=100
# Optional shared local SQLite path; default instance/generation-limits.sqlite3
# GENERATION_LIMIT_DB=
